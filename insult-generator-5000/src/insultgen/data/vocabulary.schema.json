{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "insultgen vocabulary dataset",
  "description": "Editor-support schema. The authoritative checks, including cross-references and duplicates, live in insultgen.validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "concepts",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/concept"
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term",
        "part_of_speech",
        "primary_concept",
        "secondary_concepts",
        "register",
        "severity",
        "formality",
        "vulgarity",
        "archaicness",
        "meaning_or_nuance",
        "usage_notes",
        "compatible_concepts"
      ],
      "properties": {
        "term": {
          "type": "string",
          "minLength": 1
        },
        "part_of_speech": {
          "enum": [
            "noun",
            "adjective",
            "verb",
            "adverb"
          ]
        },
        "primary_concept": {
          "type": "string",
          "minLength": 1
        },
        "secondary_concepts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "register": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "casual",
              "formal",
              "archaic",
              "academic",
              "legal",
              "vulgar"
            ]
          }
        },
        "severity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "formality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "vulgarity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "archaicness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "meaning_or_nuance": {
          "type": "string",
          "minLength": 1
        },
        "usage_notes": {
          "type": "string",
          "minLength": 1
        },
        "compatible_concepts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "polarity": {
          "enum": [
            "pejorative",
            "neutral",
            "positive"
          ]
        },
        "review_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "obscure",
              "obsolete",
              "regional",
              "disputed",
              "sensitive"
            ]
          }
        }
      }
    }
  }
}
